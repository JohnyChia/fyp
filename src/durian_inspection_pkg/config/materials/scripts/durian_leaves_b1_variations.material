
material leaf_healthy_v0
{
  technique
  {
    pass
    {
      depth_write on
      depth_check on
      alpha_rejection greater 128
      cull_hardware none
      ambient 1.0 1.0 1.0 1.0
      diffuse 1.0 1.0 1.0 1.0
      
      texture_unit
      {
        texture leaf_healthy_v0.png
        tex_address_mode clamp
        filtering trilinear
        max_anisotropy 8
      }
    }
  }
}

