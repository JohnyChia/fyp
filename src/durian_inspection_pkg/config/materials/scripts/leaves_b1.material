material leaf_healthy_b1
{
  technique
  {
    pass
    {
      depth_write on
      depth_check on
      alpha_rejection greater 128
      cull_hardware none
      ambient 0.5 0.5 0.5 1.0
      diffuse 0.8 0.8 0.8 1.0
      
      texture_unit
      {
        texture leaf_healthy.png
        tex_address_mode clamp
        filtering trilinear
        max_anisotropy 8
      }
    }
  }
}

