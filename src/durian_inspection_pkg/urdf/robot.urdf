<?xml version="1.0"?>
<robot name="durian_bot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- 通用惯性矩阵宏：支持自定义质量 -->
  <xacro:macro name="default_inertial" params="mass ixx iyy izz">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${ixx}" ixy="0.0" ixz="0.0" iyy="${iyy}" iyz="0.0" izz="${izz}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0.05"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- 主车体：总重 20kg，扣除4个轮子各2kg后，车身主体设为 12kg -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.3 0.1"/></geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.4 0.3 0.1"/></geometry>
    </collision>
    <xacro:default_inertial mass="12.0" ixx="0.1" iyy="0.17" izz="0.2"/>
  </link>

  <!-- 轮子 Macro：每个轮子设定为 2.0 kg -->
  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}_wheel">
      <visual>
        <geometry><cylinder radius="0.05" length="0.02"/></geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.05" length="0.02"/></geometry>
      </collision>
      <xacro:default_inertial mass="2.0" ixx="0.0013" iyy="0.0013" izz="0.0025"/>
    </link>
    
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} -0.05" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <gazebo reference="${prefix}_wheel">
      <mu1>1.2</mu1>
      <mu2>0.1</mu2>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
      <fdir1>1 0 0</fdir1>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left_front" x="0.1" y="0.18"/>
  <xacro:wheel prefix="right_front" x="0.1" y="-0.18"/>
  <xacro:wheel prefix="left_rear" x="-0.1" y="0.18"/>
  <xacro:wheel prefix="right_rear" x="-0.1" y="-0.18"/>

  <!-- 激光雷达 Link：修正为轻微向上倾斜 20 度 (-0.349 rad)，兼顾导航与上方树冠扫描 -->
  <link name="laser">
    <visual>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
    </collision>
    <xacro:default_inertial mass="0.2" ixx="0.0001" iyy="0.0001" izz="0.0001"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.25 0.0 0.8" rpy="0 0 0"/>
  </joint>

  <!-- 相机 Link：向上倾斜 30 度 (-0.5236 rad)，专攻中高层病害叶片 -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.08 0.03"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.02 0.08 0.03"/></geometry>
    </collision>
    <xacro:default_inertial mass="0.1" ixx="1e-5" iyy="1e-5" izz="1e-5"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0 0.8" rpy="0 -0.5236 0"/>
  </joint>

  <link name="camera_link_optical">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- 激光雷达 Gazebo 插件 -->
  <gazebo reference="laser">
    <sensor name="laser_sensor" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <material>Gazebo/Red</material>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan_filtered</remapping>
        </ros>
        <frame_name>laser</frame_name>
        <output_type>sensor_msgs/LaserScan</output_type>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 深度相机 Gazebo 插件 -->
  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="depth">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10.0</update_rate>
      <camera name="camera">
        <horizontal_fov>1.0</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>15.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>image_raw:=/camera/image_raw</remapping>
          <remapping>camera_info:=/camera/camera_info</remapping>
          <remapping>depth/image_raw:=/camera/depth/image_raw</remapping>
          <remapping>depth/camera_info:=/camera/depth/camera_info</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_link_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 四轮驱动滑移控制器 -->
  <gazebo>
    <plugin name="skid_steer_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <num_wheel_pairs>2</num_wheel_pairs>
      
      <left_joint>left_front_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_rear_wheel_joint</right_joint>

      <wheel_separation>0.36</wheel_separation>
      <wheel_diameter>0.1</wheel_diameter>

      <max_wheel_torque>200</max_wheel_torque>
      <max_wheel_acceleration>1.5</max_wheel_acceleration>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>

</robot>